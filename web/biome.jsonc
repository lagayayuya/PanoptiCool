{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    // Biome does NOT read an Astro file's template, only its frontmatter. Any const or import that
    // is used only in the markup therefore looks dead to it — a systematic false positive, not a
    // signal we would be choosing to ignore.
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    // Snapshots are GENERATED artifacts: `vitest -u` rewrites them entirely, so no `biome-ignore`
    // survives in them. A lint finding there is structurally unfixable IN PLACE — its only possible
    // correction is at the source, where it is already taken and documented (the language
    // selector's `role="group"` carries its ratified `biome-ignore` in SiteHeader.tsx).
    // The FORMATTER keeps them: it is the linter alone that has nothing to say to them.
    //
    // WHAT THIS COSTS, and what must stay visible (yuya's decision, 2026-07-18): a real
    // accessibility regression appearing ONLY in a golden would no longer be flagged by the lint.
    // The golden's diff would show it; it still has to be read.
    {
      "includes": ["**/__snapshots__/**"],
      "linter": { "enabled": false }
    },
    {
      "includes": ["src/engine/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["preact", "preact/**", "@preact/**"],
                    "message": "The engine (engine/) must stay UI-agnostic: no Preact (ADR-0002, PANO-19)."
                  },
                  {
                    "group": ["astro", "astro:*", "astro/**", "@astrojs/**"],
                    "message": "The engine does not depend on the Astro shell (ADR-0002, PANO-19)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}

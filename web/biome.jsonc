{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    // Biome ne lit PAS le template d'un fichier Astro, seulement son frontmatter. Toute const ou
    // tout import qui n'y sert que dans le balisage lui paraît donc mort — un faux positif
    // systématique, et non un signal qu'on choisirait d'ignorer.
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    // Les snapshots sont des artefacts GÉNÉRÉS : `vitest -u` les réécrit entièrement, donc aucun
    // `biome-ignore` n'y survit. Un constat de lint y est structurellement irréparable SUR PLACE —
    // sa seule correction possible est à la source, où elle est déjà prise et documentée (le
    // `role="group"` du sélecteur de langue porte son `biome-ignore` ratifié dans SiteHeader.tsx).
    // Le FORMATEUR les garde : c'est le linter seul qui n'a rien à leur dire.
    //
    // CE QUE ÇA COÛTE, et qui doit rester visible (décision yuya, 2026-07-18) : une vraie régression
    // d'accessibilité qui n'apparaîtrait QUE dans un golden ne serait plus signalée par le lint. Le
    // diff du golden la montrerait ; encore faut-il la lire.
    {
      "includes": ["**/__snapshots__/**"],
      "linter": { "enabled": false }
    },
    {
      "includes": ["src/engine/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["preact", "preact/**", "@preact/**"],
                    "message": "Le moteur (engine/) doit rester agnostique de l'UI : pas de Preact (ADR-0002, PANO-19)."
                  },
                  {
                    "group": ["astro", "astro:*", "astro/**", "@astrojs/**"],
                    "message": "Le moteur ne dépend pas de la coquille Astro (ADR-0002, PANO-19)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}

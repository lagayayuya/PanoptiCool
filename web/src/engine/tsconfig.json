{
  // Engine boundary (PANO-19, ADR-0002): pure TS, no DOM.
  // Extends the Astro `strict` preset directly (and NOT ../../tsconfig.json): otherwise the engine
  // inherits the shell's `jsxImportSource: preact`, TS loads preact/jsx-runtime whose types do
  // `/// <reference lib="dom" />`, which re-injects the whole DOM and undoes the boundary.
  // Consequence: the strict++ flags are redeclared here (the engine has its own typecheck contract).
  // Enforced by a 2nd `tsc -p` pass in the `typecheck` script.
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "lib": ["ES2022", "WebWorker"],
    "types": [],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  // The `*.test.ts` are outside the no-DOM pass: they are tooling (Vitest, node env), not shipped
  // engine code. They stay typed by `astro check` (root) and executed by Vitest.
  "exclude": ["**/*.test.ts", "dist"]
}

{
  // Frontière moteur (PANO-19, ADR-0002) : TS pur, sans DOM.
  // Étend directement le preset Astro `strict` (et NON ../../tsconfig.json) : sinon le moteur
  // hérite du `jsxImportSource: preact` de la coquille, TS charge preact/jsx-runtime dont les
  // types font `/// <reference lib="dom" />`, ce qui réinjecte tout le DOM et défait la frontière.
  // Conséquence : les flags strict++ sont redéclarés ici (le moteur a son propre contrat de
  // typecheck). Enforced par une 2ᵉ passe `tsc -p` dans le script `typecheck`.
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "lib": ["ES2022", "WebWorker"],
    "types": [],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  // Les `*.test.ts` sont hors de la passe no-DOM : c'est du tooling (Vitest, env node), pas du
  // code moteur shippé. Ils restent typés par `astro check` (racine) et exécutés par Vitest.
  "exclude": ["**/*.test.ts", "dist"]
}

---
// Le <head> commun aux 3 pages : favicon, et les balises d'aperçu de partage (Open Graph +
// Twitter Card) que lisent Slack, Discord, iMessage, Signal, Mastodon, LinkedIn…
//
// UNE maison : ces balises sont identiques d'une page à l'autre à trois valeurs près. Les recopier
// dans chaque page fabriquerait la divergence du jour où le domaine ou l'image change.
//
// `og:image` DOIT être une URL absolue : les robots d'aperçu ne résolvent pas les chemins relatifs.
// D'où `SITE` en dur — c'est le domaine de production, pas une préférence de dev.
//
// Rendu à la compilation (Astro) : aucun JS n'atteint le navigateur. `mentions-legales` reste donc
// la page zéro-JS qu'elle revendique.

interface Props {
  title: string;
  description: string;
  /** Chemin de CETTE page, pour `og:url` (« / », « /analyse », …). */
  path: string;
}

const { title, description, path } = Astro.props;

const SITE = 'https://panopti.cool';
const pageUrl = new URL(path, SITE).href;
const ogImage = `${SITE}/og.jpg`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />

<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="PanoptiCool" />
<meta property="og:locale" content="fr_FR" />
<meta property="og:url" content={pageUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="PanoptiCool — découvre ce que tes réseaux savent de toi. 100 % local, open source, sans compte."
/>

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

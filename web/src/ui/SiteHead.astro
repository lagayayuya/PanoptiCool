---
// The <head> common to the pages: favicon, canonical, language alternates, and the share-preview
// tags (Open Graph + Twitter Card) that Slack, Discord, iMessage, Signal, Mastodon,
// LinkedIn… read.
//
// ONE home: these tags are identical from one page to the next except for three values. Recopying
// them in each page would fabricate the divergence of the day the domain or the image changes.
//
// THE DOMAIN COMES FROM `Astro.site` (astro.config.ts) and is no longer written here. It was, and it
// could not survive two language trees: each absolute URL — canonical, alternates,
// og:url, og:image — must derive from the SAME domain, and a recopied domain ends up diverging.
//
// `og:image` MUST be an absolute URL: preview bots do not resolve relative paths.
//
// THE ALTERNATES ONLY READ THE PUBLISHED LANGUAGES. It is the central rule of `i18n/locales.ts`,
// and it is here that it truly plays out: a `<link rel="alternate">` is an INVITATION to index.
// Naming an unbuilt language in one would make a shell crawled — the exact mistake the list
// `PUBLISHED_LOCALES` exists to make impossible.
//
// Rendered at compile time (Astro): no JS reaches the browser. `mentions-legales` therefore stays
// the zero-JS page it claims to be.

// The hover CSS is global to the site: one class per family of elements, imported here so that
// each page has it without recopying it. Pure CSS — `mentions-legales` stays zero-JS.
import './hover.css';

import {
  DEFAULT_LOCALE,
  HTML_LANG,
  type Locale,
  localePath,
  OG_LOCALE,
  PUBLISHED_LOCALES,
} from '../i18n/locales';
import { headCopy } from './head-copy';

interface Props {
  title: string;
  description: string;
  /**
   * Path of THIS page, WITHOUT the language (« / », « /tiktok », …). The language is added here, so
   * that the caller does not have to know the shape of localized URLs.
   */
  path: string;
}

const { title, description, path } = Astro.props;

// `Astro.currentLocale` is deduced from the page's folder (`pages/fr/…`). It is undefined for the
// root page, which is in no language folder: it canonizes toward the default language.
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;

const site = Astro.site;
if (site === undefined) {
  // Without `site`, all the absolute URLs of this file would be silently wrong — a broken
  // preview and a relative canonical are not seen at build. Better to refuse to build.
  throw new Error('SiteHead: `site` must be defined in astro.config.ts.');
}

const canonical = new URL(localePath(locale, path), site).href;
/**
 * ⚠ ONE SHARE CARD PER LANGUAGE, and the alt text is what proves this was half-done. That string was
 * already localized here — the comment below still records why — while the IMAGE it describes stayed
 * a single `/og.jpg` carrying « Découvre ce que tes réseaux savent de toi » to every English reader.
 * The alt is read by a screen reader; the image is the first thing anyone sees when the link is
 * shared, in Slack, in iMessage, in a group chat. The bigger half was the one left behind.
 *
 * Both are now shot from the home page itself in each language (`scripts/shoot-preview.mjs og <l>`),
 * which is also what retires the previous card: it was a separate design, in a monospace theme two
 * versions old, that no redesign could reach because it was an asset rather than a page.
 */
const ogImage = new URL(`/og.${locale}.jpg`, site).href;
const alternates = PUBLISHED_LOCALES.map((l) => ({
  hreflang: HTML_LANG[l],
  href: new URL(localePath(l, path), site).href,
}));
const xDefault = new URL(localePath(DEFAULT_LOCALE, path), site).href;

// The share image's alt text was written here, in French, for BOTH language trees — so `/en`
// served a French alt to every preview bot and every screen reader. It reads the perimeter now.
const { ogImageAlt } = headCopy(locale);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />

<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
<link rel="alternate" hreflang="x-default" href={xDefault} />

<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="PanoptiCool" />
<meta property="og:locale" content={OG_LOCALE[locale]} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

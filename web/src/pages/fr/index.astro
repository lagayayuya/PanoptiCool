---
// Home page (2026-07-15 design rework, « Accueil v2 » mockup) — REPLACES the historical
// home page. Static build (ADR-0001/0002); the interactivity (consent modal, animated eye)
// lives in a single `client:only` island, as everywhere else.
//
// The shell — doctype, `<html lang>`, the font, the base global styles — lives in
// `layouts/Page.astro`; the `<head>` prose lives in the ratifiable perimeter (`copy.*`, group
// `UI_HEAD`) and is read here by PARAMETER, because at build there is no `<html lang>` for
// `copy.ts` to resolve from.
import { DEFAULT_LOCALE, type Locale } from '../../i18n/locales';
import Page from '../../layouts/Page.astro';
import { headCopy } from '../../ui/head-copy';
import { LandingPage } from '../../ui/v2/LandingPage';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const head = headCopy(locale);
---

<Page title={head.homeTitle} description={head.homeDescription} path="/">
  <LandingPage client:only="preact" />
</Page>

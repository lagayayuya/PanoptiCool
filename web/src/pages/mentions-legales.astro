// site dans ce cas, et la seule à exercer la raison SSG d'ADR-0002. Ne pas y ajouter d'interactivité
// sans raison : sa valeur est d'être lisible sans exécuter une ligne de script.
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';

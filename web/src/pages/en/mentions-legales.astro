---
// ENGLISH legal page — twin of `fr/mentions-legales.astro`. A TEXT page: pure Astro, no
// island, zero JS, like its twin.
//
// ⚠ THIS TEXT IS NOT THE BINDING TEXT, and the page says so itself in the last line.
// « Mentions légales » is an obligation of FRENCH law (LCEN art. 6-III); *legal notice* is
// its closest label, not the regime. Two pages both claiming to be
// binding would contend for authority in two different bodies of law — hence the explicit reference
// to the French version, which does not exist in the French and is therefore not a translation.
//
// Three qualifications do NOT cross over and are rendered in their ordinary sense, never in an invented
// statutory equivalent: « édité à titre non professionnel et sans but lucratif » (a lightened
// disclosure regime, specific to French law), « hébergeur » (a French obligation, kept as
// mere information), and the scope of « au sens du RGPD » — exact, but silent on the CCPA or
// any other regime this text, read outside the EU, does not claim to cover.

import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import { DEFAULT_LOCALE, HTML_LANG, type Locale, localePath } from '../../i18n/locales';
import SiteHead from '../../ui/SiteHead.astro';

// The language comes from the page's FOLDER, it is not written here: it is what makes
// `<html lang>` true by construction in each language tree — and `i18n/current.ts`,
// which reads this attribute to fabricate the islands' links, depends on it entirely.
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <SiteHead
      title="PanoptiCool — legal notice"
      description="Publisher, host, and what PanoptiCool does not collect."
      path="/mentions-legales"
    />
  </head>
  <body>
    <main>
      <a class="back" href={localePath(locale, '/')}>← Back</a>

      <h1>Legal notice</h1>

      <h2>Publisher</h2>
      <p>
        PanoptiCool is published on a non-professional, non-profit basis by <strong>Yuya</strong>.
      </p>
      <p>
        Contact: <a href="mailto:yuya@panopti.cool">yuya@panopti.cool</a>
      </p>

      <h2>Host</h2>
      <p>
        OVH SAS — 2 rue Kellermann, 59100 Roubaix, France<br />
        Phone: 1007 · RCS Lille Métropole 424 761 419<br />
        <a href="https://www.ovhcloud.com/fr/">ovhcloud.com</a>
      </p>

      <h2>Personal data</h2>
      <p>
        <strong>PanoptiCool collects nothing.</strong> This isn't a promise, it's a consequence of
        how it's built.
      </p>
      <ul>
        <li>
          <strong>Your export never leaves your device.</strong> It is not sent, uploaded or stored:
          the site is a set of static files, and the analysis runs in your browser. There is no
          server to send it to.
        </li>
        <li><strong>No cookies</strong>, no trackers, no analytics.</li>
        <li><strong>No account</strong>, no forms, no sign-up.</li>
        <li>
          <strong>No connection logs.</strong> The server that serves you this page keeps neither
          your IP address nor your visit.
        </li>
      </ul>
      <p>
        There is therefore no processing of personal data within the meaning of the GDPR. There is
        no right of access, rectification or erasure to exercise: there is nothing to consult,
        correct or delete.
      </p>

      <h2>The AI analysis, if you use it</h2>
      <p>
        The results page offers to have your comments and searches read by a language model. That
        model runs <strong>on your own machine</strong>, in a server you start yourself. Nothing is
        sent to a third party, and this analysis only begins when you explicitly click.
      </p>

      <h2>What PanoptiCool displays</h2>
      <p>
        The tool shows what an algorithm <em>could</em> infer from a data export. It is not a
        diagnosis, nor a verdict on a person: it is a demonstration of a system. The inferences
        shown can be wrong, and when they are, that is also the point.
      </p>

      <h2>Code and licence</h2>
      <p>
        The code is free software, under the <a href="https://www.gnu.org/licenses/agpl-3.0.html"
          >AGPL-3.0-only</a
        > licence. You can read it, check it and reuse it:
        <a href="https://github.com/lagayayuya/PanoptiCool">github.com/lagayayuya/PanoptiCool</a>.
      </p>

      <p class="dim">
        This page is an English translation provided for convenience. The French version (<a
          href={localePath('fr', '/mentions-legales')}>mentions légales</a
        >) is the legally binding text.
      </p>
    </main>

    <style is:global>
      :root {
        color-scheme: dark;
        font-family: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
      }
      body {
        margin: 0;
        background: #070b18; /* NAVY.bgPage */
        color: #e9eefb; /* NAVY.textBright */
      }
      a {
        color: #2fd4f0;
      }
      main {
        max-width: 680px;
        margin: 0 auto;
        padding: 48px 20px 80px;
      }
      .back {
        display: inline-block;
        font-size: 11px;
        color: #8b98c0; /* NAVY.textMuted */
        text-decoration: none;
        margin-bottom: 32px;
      }
      .back:hover {
        color: #2fd4f0;
      }
      h1 {
        font-size: 22px;
        line-height: 1.3;
        margin: 0 0 32px;
      }
      h2 {
        font-size: 13px;
        line-height: 1.4;
        color: #dde4f4; /* NAVY.textHeading */
        margin: 36px 0 12px;
      }
      p,
      li {
        font-size: 12px;
        line-height: 1.75;
        color: #aab6d6; /* NAVY.textBody */
      }
      p {
        margin: 0 0 12px;
      }
      ul {
        margin: 0 0 12px;
        padding-left: 18px;
      }
      li {
        margin-bottom: 8px;
      }
      strong {
        color: #c8d2e8; /* NAVY.textSecondary */
      }
      .dim {
        font-size: 11px;
        color: #66739a; /* NAVY.textDim */
        margin-top: 36px;
      }
    </style>
  </body>
</html>

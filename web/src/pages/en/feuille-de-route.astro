---
// ENGLISH roadmap page — twin of `fr/feuille-de-route.astro`. The SLUG stays French
// (`/en/feuille-de-route`), like `/en/mentions-legales`: the site's URL space is the product of
// `PAGE_PATHS` by the published languages, and a path that changed with the language would give
// each page two addresses to keep in step for nothing.
//
// The shell lives in `layouts/Page.astro`; the `<head>` prose lives in the ratifiable perimeter
// and is read by PARAMETER (`headCopy`), because at build there is no `<html lang>` for `copy.ts`
// to resolve from.
import { DEFAULT_LOCALE, type Locale } from '../../i18n/locales';
import Page from '../../layouts/Page.astro';
import { headCopy } from '../../ui/head-copy';
import { RoadmapPage } from '../../ui/v2/RoadmapPage';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const head = headCopy(locale);
---

<Page title={head.roadmapTitle} description={head.roadmapDescription} path="/feuille-de-route">
  <RoadmapPage client:only="preact" />
</Page>

---
// Analysis journey (2026-07-15 design rework, « PanoptiCool v4 — parcours guidé » mockup) —
// English twin of `fr/analyse.astro`. `?demo` → synthetic export through the real engine;
// otherwise upload of the real export (drag & drop). All the interactivity lives in the single
// `client:only` island (ADR-0002), as elsewhere.
//
// The shell lives in `layouts/Page.astro`; what stays here is what only this page needs — the
// scroll offset under the sticky table of contents, and the global `@keyframes` the loading
// spinner's inline style refers to (an inline style cannot declare its own keyframes).
import { DEFAULT_LOCALE, type Locale } from '../../i18n/locales';
import Page from '../../layouts/Page.astro';
import { headCopy } from '../../ui/head-copy';
import { AnalysisPage } from '../../ui/v2/AnalysisPage';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const head = headCopy(locale);
---

<Page title={head.analyseTitle} description={head.analyseDescription} path="/analyse">
  <style is:global slot="page-style">
    html {
      scroll-behavior: smooth;
      scroll-padding-top: 80px; /* table of contents: the anchors stop under the sticky bar */
    }
    /* Mobile (« v4 Mobile » mockup): the sticky bar is taller (logo row + table-of-contents
       chips) — same threshold as MOBILE_QUERY (ui/v2/useIsMobile.ts, to keep aligned). */
    @media (max-width: 720px) {
      html {
        scroll-padding-top: 132px;
      }
    }
    /* Loading-screen spinner (inline styles — the global @keyframes lives here). */
    @keyframes pano-spin {
      to {
        transform: rotate(360deg);
      }
    }
  </style>
  <AnalysisPage client:only="preact" />
</Page>
